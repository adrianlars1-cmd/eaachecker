NODE_ENV=development
PORT=4000

# Local Postgres (see docker-compose.yml at repo root)
DATABASE_URL=postgresql://eaachecker:eaachecker@localhost:5432/eaachecker

JWT_SECRET=replace-with-a-long-random-string-before-deploying

# Required even in local dev for the free-scan AI summary to work.
ANTHROPIC_API_KEY=sk-ant-dummy-key-here

# Fill in with real test-mode keys before testing Stripe end-to-end.
STRIPE_SECRET_KEY=sk_test_dummy
STRIPE_WEBHOOK_SECRET=whsec_dummy
STRIPE_PRICE_ID=price_dummy

# Fill in before testing email end-to-end.
SENDGRID_API_KEY=SG.dummy
SENDGRID_FROM_EMAIL=noreply@eaachecker.com

FRONTEND_URL=http://localhost:5173
ENABLE_CRON_DEV=false
